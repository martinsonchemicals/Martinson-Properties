# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# app data (legacy local SQLite database + uploaded photos, pre-Cloudflare-migration)
/data/
/public/uploads/

# Cloudflare / OpenNext build output and local state
/.open-next/
/.wrangler/
.dev.vars
.dev.vars.*

# Note: cloudflare-env.d.ts (generated by `npm run cf-typegen`) is
# intentionally NOT gitignored -- it's committed so Cloudflare's build
# step has the D1/R2 binding types available without an extra generation
# step. Re-run `npm run cf-typegen` and commit the result any time you
# change wrangler.jsonc's bindings.
